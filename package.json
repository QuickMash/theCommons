{
  "name": "theCommons",
  "version": "0.0.1 dev",
  "description": "An Electron application",
  "main": "build/main.js",
  "homepage": "./",
  "scripts": {
    "start": "npm run renderer:build && npm run electron:build && electron .",
    "dev": "vite build --watch",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "electron:build": "tsc -p tsconfig.electron.json",
    "renderer:build": "npm run typecheck && vite build",
    "build": "npm run renderer:build && npm run electron:build && electron-builder",
    "build:win": "npm run renderer:build && npm run electron:build && electron-builder --win",
    "build:mac": "npm run renderer:build && npm run electron:build && electron-builder --mac",
    "build:linux": "npm run renderer:build && npm run electron:build && electron-builder --linux"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.5.0",
    "electron-builder": "^26.15.3",
    "sass": "^1.90.0",
    "typescript": "^7.0.2",
    "vite": "^7.1.3",
    "vite-plugin-handlebars": "^2.0.0"
  },
  "dependencies": {
    "@fontsource/anta": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/zen-dots": "^5.3.0",
    "@mantine/code-highlight": "^8.3.18",
    "@mantine/core": "^8.2.2",
    "@mantine/hooks": "^8.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.112.4",
    "electron-store": "^11.0.2",
    "emoji-picker-element": "^1.29.1",
    "gif-picker-react": "^2.0.0",
    "handlebars": "^4.7.10",
    "irc-framework": "^4.14.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "build": {
    "appId": "com.example.app",
    "productName": "theCommons Dekstop",
    "files": [
      "build/**/*",
      "src/**/*",
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
